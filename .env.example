# Copy to .env. Replace local password placeholders before starting.
DB_PASSWORD=replace-with-a-strong-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
DB_USER=haritha
DB_URL=jdbc:mysql://localhost:3306/haritha_vastra?connectionTimeZone=UTC
# demo loads four fictional products. Use a fresh database for production.
SPRING_PROFILES_ACTIVE=demo
DEMO_DATA=true
ADMIN_EMAIL=
# Optional initial admin, 12–72 characters. No default admin is shipped.
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Amounts are rupees. Rate is a fraction: 0.05 means 5%.
# These are configuration examples, NOT tax or shipping advice.
SHIPPING_RUPEES=0.00
TAX_RATE=0.00
